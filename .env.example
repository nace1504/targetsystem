# Database
DATABASE_URL=postgresql://ts:ts@postgres:5432/targetsystem
INGEST_DB_URL=postgresql://ts:ts@postgres:5432/targetsystem

# Service URLs nội bộ (ts-sandbox-net / ts-tools-net / ts-dmz-net)
QDRANT_URL=http://qdrant:6333
HOSTREGISTRY_URL=http://host-registry:8000
RAG_URL=http://rag:8000
GATEWAY_URL=http://gateway:8000
TOOLS_URL=http://tools:8000

# Gateway IAM (docs/04-technical-design.md mục 4.1) — 2 key PHẢI khác nhau
AGENT_B_API_KEY=
PRIVILEGED_API_KEY=

# A2A signing (mục 8.3) — sinh ngẫu nhiên lúc docker-compose up lần đầu, không hardcode
A2A_SIGNING_SECRET=

# Biến thể testbed — "unpatched" | "patched" (mục 8.3, FR-T6)
TARGET_VARIANT=unpatched

# LLM (Agent A/B) — rỗng = chạy heuristic fallback, mode="heuristic"
LLM_API_KEY=

# Test
RUN_LLM_TESTS=0   # 1 = cho phép test gọi LLM thật, mặc định 0 = skip có lý do rõ ràng
RAG_BACKEND=qdrant   # "qdrant" | "inmemory" — inmemory dùng cho tests/unit offline (mục 16)

# Langfuse (mục 11 — cloud free-tier, đã chốt trong trd_swarmsentinel.md §8, không self-host)
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Wazuh (lớp ingest, mục 12)
WAZUH_API_URL=https://wazuh-manager:55000
WAZUH_API_USER=
WAZUH_API_PASS=

# Tailscale (mục 17) — auth key reusable, ephemeral, KHÔNG dùng key vĩnh viễn
TAILSCALE_AUTHKEY=
